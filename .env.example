APP_NAME=PPCosta
APP_ENV=production
APP_DEBUG=false
APP_URL=https://www.exemplo.pt
APP_TIMEZONE=Europe/Lisbon

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ppcosta_store
DB_USER=ppcosta_user
DB_PASS=alterar_esta_password
DB_CHARSET=utf8mb4

UPLOAD_DIR=/var/www/ppcosta/uploads
MAX_UPLOAD_BYTES=10485760

MAIL_FROM_EMAIL=no-reply@exemplo.pt
MAIL_FROM_NAME=PPCosta
MAIL_TRANSPORT=mail
MAIL_LOG_DIR=/var/www/ppcosta/uploads/mail
BANK_TRANSFER_IBAN=PT50 0000 0000 0000 0000 0000 0
